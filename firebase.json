{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "regex": "^/page/\\d+/?$",
        "destination": "/posts",
        "type": 301
      },
      {
        "regex": "^/contact(\\.html|/)?$",
        "destination": "/about",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*"
    ]
  }
}
