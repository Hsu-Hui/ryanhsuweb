---
import Icon from './Icon.astro';
import { pageHref } from '../lib/pagination';

interface Props {
  current: number;
  last: number;
}

const { current, last } = Astro.props;
const linkClass =
  'inline-flex items-center gap-1 rounded-lg border border-border px-3 py-2 font-mono text-sm hover:border-accent hover:text-accent';
---

{
  last > 1 && (
    <nav aria-label="分頁" class="mt-8 flex items-center justify-between gap-4">
      {current > 1 ? (
        <a href={pageHref(current - 1)} rel="prev" class={linkClass}>
          <Icon name="arrow-left" class="size-4" />
          上一頁
        </a>
      ) : (
        <span />
      )}
      <span class="font-mono text-sm text-muted-fg">
        第 {current} / {last} 頁
      </span>
      {current < last ? (
        <a href={pageHref(current + 1)} rel="next" class={linkClass}>
          下一頁
          <Icon name="arrow-right" class="size-4" />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
