---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2 font-mono text-xs">
      {tags.map((tag) => (
        <li>
          <a
            href={`/tags/${tag}`}
            class="inline-block rounded border border-accent/40 px-1.5 py-0.5 text-accent hover:border-accent"
          >
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
