---
// 關於我、隱私權政策這類固定頁面的外框。
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  /** 關掉時內容不套用文章排版，讓頁面自己安排版面（例如關於我的兩欄）。 */
  prose?: boolean;
}

const { title, description, prose = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="rounded-2xl border border-border bg-card p-6 sm:p-10">
    <nav aria-label="麵包屑" class="flex flex-wrap gap-x-1.5 font-mono text-sm text-muted-fg">
      <a href="/" class="hover:text-accent">~</a>
      <span aria-hidden="true">/</span>
      <span class="text-accent" aria-current="page">{title}</span>
    </nav>
    <h1 class="mt-6 text-3xl font-semibold">{title}</h1>
    <div class:list={['mt-8', prose && 'prose prose-themed max-w-none']}>
      <slot />
    </div>
  </article>
</BaseLayout>
