---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面" description="這個網址不存在。">
  <section class="rounded-2xl border border-border bg-card p-6 sm:p-10">
    <p class="font-mono text-sm text-accent">~/ 404</p>
    <h1 class="mt-3 text-2xl font-semibold">找不到這個頁面</h1>
    <p class="mt-2 text-muted-fg">網址可能打錯了，或文章已經移除。</p>
    <a href="/" class="mt-6 inline-block rounded-lg border border-accent px-4 py-2 font-mono text-sm text-accent">
      cd ~ 回首頁
    </a>
  </section>
</BaseLayout>
