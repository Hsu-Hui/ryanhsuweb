---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from '../components/Comments.astro';
import Icon from '../components/Icon.astro';
import TagList from '../components/TagList.astro';
import { formatDate } from '../lib/date';
import { getPosts, type Post } from '../lib/posts';
import { blogPostingJsonLd } from '../lib/structured-data';

export async function getStaticPaths() {
  // getPosts() 由新到舊，所以 index - 1 是較新的一篇，index + 1 是較舊的一篇。
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;
const { Content } = await render(post);
const jsonLd = blogPostingJsonLd(post, Astro.site!);
---

<BaseLayout title={title} description={description} image={cover}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <article class="rounded-2xl border border-border bg-card p-6 sm:p-10">
    <nav aria-label="麵包屑" class="flex flex-wrap gap-x-1.5 font-mono text-sm text-muted-fg">
      <a href="/" class="hover:text-accent">~</a>
      <span aria-hidden="true">/</span>
      <span>文章</span>
      <span aria-hidden="true">/</span>
      <span class="min-w-0 break-words text-accent" aria-current="page">{title}</span>
    </nav>

    <header class="mt-6">
      <h1 class="text-3xl leading-tight font-semibold break-words">{title}</h1>
      <p class="mt-3 font-mono text-xs text-muted-fg">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              {' · 更新於 '}
              <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </>
          )
        }
      </p>
      <div class="mt-3"><TagList tags={tags} /></div>
    </header>

    <div class="prose prose-themed mt-8 max-w-none">
      <Content />
    </div>

    {
      (older || newer) && (
        <nav aria-label="上一篇與下一篇" class="mt-10 grid gap-3 border-t border-border pt-6 sm:grid-cols-2">
          {older ? (
            <a href={`/${older.id}`} class="rounded-xl border border-border p-4 hover:border-accent" data-nav="previous">
              <span class="flex items-center gap-1 font-mono text-xs text-muted-fg">
                <Icon name="arrow-left" class="size-4" />
                上一篇
              </span>
              <span class="mt-1 block font-medium">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a
              href={`/${newer.id}`}
              class="rounded-xl border border-border p-4 text-right hover:border-accent"
              data-nav="next"
            >
              <span class="flex items-center justify-end gap-1 font-mono text-xs text-muted-fg">
                下一篇
                <Icon name="arrow-right" class="size-4" />
              </span>
              <span class="mt-1 block font-medium">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <Comments />
</BaseLayout>
