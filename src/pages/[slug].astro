---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from '../components/Comments.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { formatDate } from '../lib/date';
import { getPosts, getRelatedPosts, type Post } from '../lib/posts';
import { blogPostingJsonLd } from '../lib/structured-data';
import { buildToc } from '../lib/toc';

export async function getStaticPaths() {
  // getPosts() 由新到舊，所以 index - 1 是較新的一篇，index + 1 是較舊的一篇。
  const posts = await getPosts();
  return posts.map((post, index) => {
    const newer = posts[index - 1];
    const older = posts[index + 1];
    return {
      params: { slug: post.id },
      props: { post, newer, older, related: getRelatedPosts(post, posts, [newer, older], 3) },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  related: Post[];
}

const { post, newer, older, related } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;
const { Content, headings } = await render(post);
const jsonLd = blogPostingJsonLd(post, Astro.site!);
const toc = buildToc(headings);
const hasToc = toc.length > 0;
---

<BaseLayout title={title} description={description} image={cover}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  {/* 有目錄時，1280px 以上改成兩欄：左邊文章與留言，右邊 240px 的懸浮目錄。 */}
  <div class:list={[hasToc && 'xl:grid xl:grid-cols-[minmax(0,1fr)_240px] xl:gap-6']}>
  <div class="min-w-0">
  <article class="rounded-2xl border border-border bg-card p-6 sm:p-10">
    <nav aria-label="麵包屑" class="flex flex-wrap gap-x-1.5 font-mono text-sm text-muted-fg">
      <a href="/" class="hover:text-accent">~</a>
      <span aria-hidden="true">/</span>
      <span>文章</span>
      <span aria-hidden="true">/</span>
      <span class="min-w-0 break-words text-accent" aria-current="page">{title}</span>
    </nav>

    <header class="mt-6">
      <h1 class="text-3xl leading-tight font-semibold break-words">{title}</h1>
      <p class="mt-3 font-mono text-xs text-muted-fg">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              {' · 更新於 '}
              <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </>
          )
        }
      </p>
      <div class="mt-3"><TagList tags={tags} /></div>
      {
        hasToc && (
          <div class="xl:hidden">
            <TableOfContents entries={toc} form="collapsible" />
          </div>
        )
      }
    </header>

    <div class="prose prose-themed mt-8 max-w-none">
      <Content />
    </div>

    {
      (older || newer) && (
        <nav aria-label="上一篇與下一篇" class="mt-10 grid gap-3 border-t border-border pt-6 sm:grid-cols-2">
          {older ? (
            <a href={`/${older.id}`} class="rounded-xl border border-border p-4 hover:border-accent" data-nav="previous">
              <span class="flex items-center gap-1 font-mono text-xs text-muted-fg">
                <Icon name="arrow-left" class="size-4" />
                上一篇
              </span>
              <span class="mt-1 block font-medium">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a
              href={`/${newer.id}`}
              class="rounded-xl border border-border p-4 text-right hover:border-accent"
              data-nav="next"
            >
              <span class="flex items-center justify-end gap-1 font-mono text-xs text-muted-fg">
                下一篇
                <Icon name="arrow-right" class="size-4" />
              </span>
              <span class="mt-1 block font-medium">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section aria-label="相關文章" class="mt-10 border-t border-border pt-6">
          {/* 不加 id，避免和內文標題混在一起。 */}
          <h2 class="font-mono text-sm text-muted-fg">相關文章</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => <PostCard post={item} />)}
          </ul>
        </section>
      )
    }
  </article>

  <Comments />
  </div>

  {
    hasToc && (
      <aside aria-label="文章目錄" class="hidden xl:block">
        <div class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto">
          <TableOfContents entries={toc} form="panel" />
        </div>
      </aside>
    )
  }
  </div>
</BaseLayout>
