---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import PostRow from '../components/PostRow.astro';
import { countTags, getPosts } from '../lib/posts';
import { siteConfig } from '../site.config';

const LATEST_COUNT = 5;
const MARQUEE_COUNT = 8;

const posts = await getPosts();
const tags = countTags(posts);
const buttonClass =
  'inline-flex items-center gap-2 rounded-lg border px-4 py-2 font-mono text-sm hover:border-accent hover:text-accent';
---

<BaseLayout>
  <section class="rounded-2xl border border-border bg-card p-6 sm:p-10">
    <p class="font-mono text-sm text-accent">$ whoami</p>
    {/* 看不見的完整標題先撐出最終高度，打字的那層疊在同一格，打字時下方內容不會跳動。 */}
    <h1
      class="mt-3 grid text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
      aria-label={siteConfig.siteDescription}
    >
      <span class="invisible col-start-1 row-start-1" aria-hidden="true">{siteConfig.siteDescription}_</span>
      <span class="col-start-1 row-start-1">
        <span data-typewriter>{siteConfig.siteDescription}</span><span
          class="cursor-blink ml-1 text-accent"
          aria-hidden="true">_</span
        >
      </span>
    </h1>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/posts" class:list={[buttonClass, 'border-accent text-accent']}>
        <Icon name="article" class="size-4" />
        看文章
      </a>
      <a href="/about" class:list={[buttonClass, 'border-border']}>
        <Icon name="user" class="size-4" />
        關於我
      </a>
      <a href="/rss.xml" class:list={[buttonClass, 'border-border']}>
        <Icon name="rss" class="size-4" />
        RSS
      </a>
    </div>
  </section>

  <Marquee posts={posts.slice(0, MARQUEE_COUNT)} />

  {
    posts.length > 0 && (
      <section aria-labelledby="latest-heading" class="mt-6 rounded-2xl border border-border bg-card p-5 sm:p-6">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="latest-heading" class="font-mono text-sm text-muted-fg">
            ~/ <span class="text-accent">最新文章</span>
          </h2>
          <a href="/posts" class="inline-flex items-center gap-1 font-mono text-sm text-accent hover:underline">
            看全部文章
            <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
        <ul class="mt-2 divide-y divide-border">
          {posts.slice(0, LATEST_COUNT).map((post) => (
            <PostRow post={post} />
          ))}
        </ul>
      </section>
    )
  }

  {
    tags.length > 0 && (
      <section aria-labelledby="topics-heading" class="mt-6 rounded-2xl border border-border bg-card p-5 sm:p-6">
        <h2 id="topics-heading" class="font-mono text-sm text-muted-fg">
          ~/ <span class="text-accent">依主題瀏覽</span>
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2 font-mono text-sm">
          {tags.map(([tag, count]) => (
            <li>
              <a
                href={`/posts?tag=${encodeURIComponent(tag)}`}
                class="inline-block rounded border border-accent/40 px-2 py-1 text-accent hover:border-accent"
              >
                #{tag} ({count})
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<script>
  // HTML 裡已經有完整標題（給搜尋引擎和沒有 JavaScript 的讀者），這裡只負責逐字打出的效果。
  const CHAR_DELAY_MS = 90;
  const target = document.querySelector<HTMLElement>('[data-typewriter]');

  if (target && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // 用 Array.from 切字，中文、英文和 emoji 都能一個字一個字打。
    const chars = Array.from(target.textContent ?? '');
    target.textContent = '';
    let index = 0;
    const timer = setInterval(() => {
      target.textContent += chars[index];
      index += 1;
      if (index >= chars.length) clearInterval(timer);
    }, CHAR_DELAY_MS);
  }
</script>
