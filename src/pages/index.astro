---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from '../components/Pagination.astro';
import PostList from '../components/PostList.astro';
import { PAGE_SIZE } from '../lib/pagination';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const last = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
---

<BaseLayout>
  <h1 class="mb-6 font-mono text-sm text-muted-fg">~/ <span class="text-accent">文章</span></h1>
  <PostList posts={posts.slice(0, PAGE_SIZE)} />
  <Pagination current={1} last={last} />
</BaseLayout>
