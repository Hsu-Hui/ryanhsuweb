---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { CATEGORIES, type Category } from '../lib/categories';
import { formatDate } from '../lib/date';
import { countTags, getPosts } from '../lib/posts';

const posts = await getPosts();
const tags = countTags(posts);
const categories = (Object.entries(CATEGORIES) as [Category, string][]).map(
  ([key, label]) => [key, label, posts.filter((post) => post.data.category === key).length] as const,
);

// 依台北時區的年份分組；getPosts() 已經由新到舊，所以分組後順序不變。
const years = new Map<string, typeof posts>();
for (const post of posts) {
  const year = formatDate(post.data.pubDate).slice(0, 4);
  years.set(year, [...(years.get(year) ?? []), post]);
}

const chipClass =
  'inline-block rounded border border-accent/40 px-2 py-1 font-mono text-sm text-accent hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-card';
const tabClass =
  'inline-block border-b-2 border-transparent px-1 pb-2 font-semibold text-muted-fg hover:text-accent aria-pressed:border-accent aria-pressed:text-accent';
---

<BaseLayout title="文章" description="依分類或標籤瀏覽所有文章。">
  <h1 class="mb-6 font-mono text-sm text-muted-fg">~/ <span class="text-accent">文章</span></h1>

  <nav aria-label="文章分類" class="mb-6 border-b border-border">
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <li><a href="/posts" class={tabClass} data-category-filter="" aria-pressed="true">全部</a></li>
      {
        categories.map(([key, label, count]) => (
          <li>
            <a href={`/posts?category=${key}`} class={tabClass} data-category-filter={key}>
              {label} <span class="font-mono text-xs">({count})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="flex flex-col gap-6">
    {
      [...years].map(([year, items]) => (
        <section data-year={year} class="rounded-2xl border border-border bg-card p-5 sm:p-6">
          <h2 class="font-mono text-2xl font-semibold text-muted-fg">{year}</h2>
          <ul class="mt-3 divide-y divide-border">
            {items.map((post) => (
              <PostRow post={post} dateFormat="monthDay" />
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <nav aria-label="依標籤篩選" class="mt-8">
    <h2 class="mb-3 font-mono text-sm text-muted-fg">標籤</h2>
    <ul class="flex flex-wrap gap-2">
      <li><a href="/posts" class={chipClass} data-filter="" aria-pressed="true">全部</a></li>
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={`/tags/${encodeURIComponent(tag)}`} class={chipClass} data-filter={tag}>
              #{tag} ({count})
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>

<script>
  // 沒有 JavaScript 時，標籤就是一般的標籤頁連結；有 JavaScript 時改成在頁面內篩選。
  // 分類和標籤一次只套用一種，選了其中一種就清掉另一種。
  type Kind = 'category' | 'tag';
  const chips: Record<Kind, HTMLAnchorElement[]> = {
    category: [...document.querySelectorAll<HTMLAnchorElement>('[data-category-filter]')],
    tag: [...document.querySelectorAll<HTMLAnchorElement>('[data-filter]')],
  };
  const valueOf = (kind: Kind, chip: HTMLElement) =>
    (kind === 'category' ? chip.dataset.categoryFilter : chip.dataset.filter) ?? '';
  const rows = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-year]')];

  function apply(kind: Kind, value: string) {
    const known = chips[kind].some((chip) => valueOf(kind, chip) === value);
    const active = { category: '', tag: '', [kind]: known ? value : '' };
    for (const k of ['category', 'tag'] as const) {
      for (const chip of chips[k]) {
        if (valueOf(k, chip) === active[k]) chip.setAttribute('aria-pressed', 'true');
        else chip.removeAttribute('aria-pressed');
      }
    }
    for (const row of rows) {
      const tags: string[] = JSON.parse(row.dataset.tags ?? '[]');
      row.hidden =
        (active.tag !== '' && !tags.includes(active.tag)) ||
        (active.category !== '' && row.dataset.category !== active.category);
    }
    for (const group of groups) {
      group.hidden = [...group.querySelectorAll<HTMLElement>('[data-post]')].every((row) => row.hidden);
    }
  }

  for (const kind of ['category', 'tag'] as const) {
    for (const chip of chips[kind]) {
      chip.addEventListener('click', (event) => {
        event.preventDefault();
        const value = valueOf(kind, chip);
        history.replaceState(null, '', value ? `/posts?${kind}=${encodeURIComponent(value)}` : '/posts');
        apply(kind, value);
      });
    }
  }

  const params = new URLSearchParams(location.search);
  if (params.has('category')) apply('category', params.get('category') ?? '');
  else apply('tag', params.get('tag') ?? '');
</script>
