---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countTags, getPosts } from '../../lib/posts';

const tags = countTags(await getPosts());
---

<BaseLayout title="標籤" description="依標籤瀏覽所有文章。">
  <h1 class="mb-6 font-mono text-sm text-muted-fg">~/ <span class="text-accent">tags</span></h1>
  <ul class="flex flex-wrap gap-3 rounded-2xl border border-border bg-card p-6 font-mono">
    {
      tags.map(([tag, count]) => (
        <li>
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="inline-block rounded border border-accent/40 px-2 py-1 text-accent hover:border-accent"
            data-tag={tag}
          >
            #{tag} ({count})
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
